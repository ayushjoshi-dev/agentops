# ============================================================
# AgentOps — Environment Variables Template
# ============================================================
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to GitHub (it's in .gitignore)
# ============================================================

# ── Application ───────────────────────────────────────────
APP_ENV=development          # Options: development | production
APP_NAME=AgentOps
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────
# Render sets PORT automatically. Do NOT hardcode 8000 in production.
PORT=8000
HOST=0.0.0.0

# CORS: comma-separated list of allowed origins
# In development: http://localhost:5173 (Vite frontend)
# In production: your Render frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Supabase / PostgreSQL ─────────────────────────────────
# Get this from: Supabase Dashboard > Project > Settings > Database > URI
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Connection pool settings (important for production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── LLM Provider (Groq — Free & Fast) ────────────────────
# Get your key from: https://console.groq.com
LLM_PROVIDER=groq
LLM_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
LLM_MODEL=llama-3.1-8b-instant
# Alternative fast models:
#   llama3-groq-70b-8192   (more capable, still free)
#   mixtral-8x7b-32768     (good for long contexts)

# LLM parameters — controls cost & quality
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1    # Low temperature = more focused, less creative

# ── Embeddings ────────────────────────────────────────────
# We use sentence-transformers (local, FREE, no API key needed)
# Model runs locally — no cost per embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# To use OpenAI embeddings instead:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-YOUR_OPENAI_KEY
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ── Authentication / Security ─────────────────────────────
# JWT secret: generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_A_RANDOM_64_CHAR_HEX_STRING_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── RAG Configuration ─────────────────────────────────────
RAG_CHUNK_SIZE=500         # Characters per chunk
RAG_CHUNK_OVERLAP=50       # Characters of overlap between chunks
RAG_TOP_K=5                # Number of chunks to retrieve per query

# ── Agent Configuration ───────────────────────────────────
AGENT_MAX_ITERATIONS=10    # Max tool calls per agent run
AGENT_TIMEOUT_SECONDS=60   # Hard timeout for agent execution

# ── Optional: OpenAI (if you prefer over Groq) ───────────
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-YOUR_OPENAI_KEY
# LLM_MODEL=gpt-4o-mini
